# Firebase Configuration
# Get these values from your Firebase Console (Project Settings > General)

# Firebase API Key
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...

# Firebase Auth Domain (usually <project-id>.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Realtime Database URL
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket (usually <project-id>.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# Firebase Measurement ID (optional, for Google Analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Note: These variables are prefixed with NEXT_PUBLIC_ because they need to be 
# accessible in the browser. Do NOT put sensitive server-only secrets here.
